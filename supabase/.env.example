# Секреты функций. НЕ попадают в браузер.
# Загрузка: npx supabase secrets set --env-file supabase/.env
# SUPABASE_URL и SUPABASE_SERVICE_ROLE_KEY Supabase подставляет сам.

# Длинная случайная строка: openssl rand -hex 32
RSVP_TOKEN_SECRET=
# Ещё одна случайная строка: openssl rand -hex 32
RSVP_IP_SALT=
# Пароль для страницы организатора, минимум 16 символов: openssl rand -hex 16
RSVP_ORGANIZER_TOKEN=
# Адреса сайта через запятую, без слэша в конце
RSVP_ALLOWED_ORIGINS=https://example.com,http://localhost:5173
# Сколько гостей, включая самого гостя, можно указать без персонального приглашения
RSVP_DEFAULT_MAX_GUESTS=2
